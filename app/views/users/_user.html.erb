<div id="<%= dom_id user %>">
  <p>
    <strong>Name:</strong>
    <%= user.name %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= user.email %>
  </p>

  <p>
    <strong>Street:</strong>
    <%= user.street %>
  </p>

  <p>
    <strong>City:</strong>
    <%= user.city %>
  </p>

  <p>
    <strong>Postal code:</strong>
    <%= user.postal_code %>
  </p>

  <p>
    <strong>Province:</strong>
    <%= user.province %>
  </p>

</div>
