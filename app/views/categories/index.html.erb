<p style="color: green"><%= notice %></p>

<% content_for :title, "Categories" %>

<h1>Categories</h1>

<div id="categories">
  <% @categories.each do |category| %>
    <%= render category %>
    <p>
      <%= link_to "Show products", category_path(category) %>
    </p>
  <% end %>
</div>

<%= link_to "New category", new_category_path %>
