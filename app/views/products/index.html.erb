<p style="color: green"><%= notice %></p>

<% content_for :title, "Products" %>

<h1>Products</h1>

<div id="products">
  <% @products.each do |product| %>
    <%= render product %>
    <p>
      <%= link_to "Show this product", product %>
      <%= button_to "Add to Cart", add_to_cart_path(product.id), method: :post, class: "btn btn-success" %>
    </p>
  <% end %>
</div>

<% if current_user&.admin? %>
  <%= link_to "New Product", new_admin_product_path, class: "btn btn-primary" %>
<% end %>

<%# Pagination controls to navigate between pages of the products %>
<%= paginate @products%>