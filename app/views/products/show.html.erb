<p style="color: green"><%= notice %></p>

<%= render @product %>
<div>
  <% if @product.image.attached? %>
    <%= image_tag @product.image.variant(resize_to_limit: [300, 300]) %>
  <% end %>
</div>

<div>
  <%= button_to "Add to Cart", add_to_cart_path(@product.id), method: :post, class: "btn btn-success" %>
  <% if current_user&.admin? %>
    <%= link_to "Edit this product", edit_admin_product_path(@product) %> |
    <%= button_to "Delete this product", admin_product_path(@product), method: :delete, data: { confirm: "Are you sure?" } %>
  <% end %>
  <%= link_to "Back to products", products_path %>
</div>
