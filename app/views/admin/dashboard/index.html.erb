<h1>Administration Dashboard</h1>

<div style="display: flex; gap: 10px;">
  <%= link_to "Manage Products", admin_products_path, class: "btn btn-primary" %>
  <%= link_to "View All Products (User List)", products_path, class: "btn btn-primary" %>
</div>
<br>
<div>
  <%= link_to "Manage the Orders", admin_orders_path, class: "btn btn-primary"%>
</div>
<h2>Summary of movements:</h2>
<p>Total Sales: $<%= number_with_precision(@total_sales, precision: 2)%></p>
<p>Total Orders: <%= @total_orders %></p>
<p>Total Users: <%= @total_users%></p>

<h2>Recent Orders</h2>
<ul>
  <%= render partial: "recent_order", collection: @orders, as: :order%>
</ul>

<h2>Low Stock Products</h2>
<ul>
  <% @low_stock_products.each do |product|%>
    <li>
      <%= product.product_name%> - <%= product.stock_quantity%> in stock
    </li>
  <% end %>
</ul>