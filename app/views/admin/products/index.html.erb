<h1>Administration - List of Products</h1>
<div>
  <%= link_to "New Product", new_admin_product_path, class: "btn btn-primary"%>
  <%= link_to "View All Products (User List)", products_path, class: "btn btn-primary" %>
</div>
<br>
<table>
  <thead>
    <tr>
      <th>Product Name</th>
      <th>Description</th>
      <th>Price</th>
      <th>Stock Quantity</th>
      <th>On Sale</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "product_row", collection: @products, as: :product%>
  </tbody>
</table>

<%# Pagination controls to navigate between pages of the products %>
<%= paginate @products%>
