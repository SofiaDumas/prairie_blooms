<h1>New Product</h1>

<%= form_with model: [:admin, @product], local: true do |form|%>
  <p><%= form.label :product_name%><br><%= form.text_field :product_name%></p>
  <p><%= form.label :description%><br><%= form.text_area :description%></p>
  <p><%= form.label :stock_quantity%><br><%= form.number_field :stock_quantity%></p>
  <p><%= form.label :price%><br><%= form.text_field :price%></p>
  <%form.submit "Save", class: btn btn-success%>
<% end %>
<%= link_to "Back to Products", admin_products_path, class: "btn btn-secondary" %>
