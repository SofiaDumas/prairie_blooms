<%= form_with(model: [:admin, @product], local: true) do |form| %>
  <% if product.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul>
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :product_name, style: "display: block" %>
    <%= form.text_field :product_name %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.label :stock_quantity, style: "display: block" %>
    <%= form.number_field :stock_quantity %>
  </div>

  <div>
    <%= form.label :category_id, "Category" %><br>
    <%= form.collection_select :category_id, Category.all, :id, :category_name, prompt: "Select a category" %>
  </div>

  <div>
    <%= form.fields_for :product_prices do |pp_form| %>
      <%= pp_form.label :price %><br>
      <%= pp_form.text_field :price %>
    <% end %>
  </div>

  <div>
    <%= form.submit "Save", class: "btn btn-success"%>
  </div>
<% end %>
