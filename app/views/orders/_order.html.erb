<div id="<%= dom_id order %>">
  <p>
    <strong>User:</strong>
    <%= order.user_id %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= order.status %>
  </p>

  <p>
    <strong>Total amount:</strong>
    <%= order.total_amount %>
  </p>

</div>

<div id="orders">
  <h3>Order #<%= order.id %> - Status: <%= order.status%></h3>
  <p>Total: $<%= number_with_precision(order.total_amount, precision: 2)%></p>
  <p>Address: <%= order.address%></p>
  <ul>
    <% order.order_items.each do |item|%>
      <li>
        <%= item.product.product_name%> x <%= item.quantity%>
        @ $<%= number_with_precision(item.price, precision: 2) %> each
      </li>
    <% end %>
  </ul>
</div>
<hr>