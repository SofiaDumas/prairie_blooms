<h1>Your Shopping Cart</h1>

<% if @cart.blank? %>
  <p>Your cart is currently empty.</p>
  <%= link_to "Browse Products", products_path, class: "btn btn-primary"%>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Product</th>
        <th>Description</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Total</th>
        <th>Action</th>
      </tr>
    </thead>
      <% total = 0 %>
      <tbody>
        <% @cart.each do |product_id, quantity| %>
          <% product = Product.find_by(id: product_id) %>
          <% if product %>
            <% price = product.product_prices.last&.price || 0 %>
            <% total += price * quantity %>
            <% line_total = price * quantity %>
            <%= render partial: "cart/cart_row", locals: { product: product, quantity: quantity, price: price, line_total: line_total, product_id: product_id } %>
          <% end %>
        <% end %>
      </tbody>
  </table>

  <h3>Total: $<%= number_with_precision(total, precision:2) %></h3>
  <%= link_to "Back to products", products_path %>
  <%= button_to "Proceed to checkout", checkout_cart_path, method: :post, class: "btn btn-success" %>
<% end %>

