<h1>Your Shopping Cart</h1>

<% if @cart.blank? %>
  <p>Your cart is currently empty.</p>
  <%= link_to "Browse Products", products_path, class: "btn btn-primary"%>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Product</th>
        <th>Description</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Total</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <%total = 0 %>
      <% @cart.each do |product_id, quantity|%>
        <% product = Product.find_by(id: product_id) %>
        <% if product %>
          <% price = product.product_prices.last&.price || 0 %>
          <% line_total = price * quantity %>
          <% total += line_total %>
          <tr>
            <td><%= product.product_name %></td>
            <td><%= product.description %></td>
            <td><%= quantity %></td>
            <td>$<%= number_with_precision(price, precision:2) %></td>
            <td>$<%= number_with_precision(line_total, precision:2) %></td>
            <td>
              <%= form_with url: update_cart_quantity_path(product_id: product.id), method: :post, local: true do |form| %>
              <%= form.number_field :quantity, value: quantity, min: 1%>
              <%= form.submit "Update", class: "btn btn-primary" %>
              <% end %>
            </td>
            <td><%= button_to "Remove", remove_from_cart_path(product_id), method: :delete, class: "btn btn-danger"%></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>

  <h3>Total: $<%= number_with_precision(total, precision:2) %></h3>
  <%= link_to "Back to products", products_path %>
  <%= button_to "Proceed to checkout", checkout_path, method: :post, class: "btn btn-success" %>
<% end %>

