<div id="<%= dom_id product_price %>">
  <p>
    <strong>Product:</strong>
    <%= product_price.product_id %>
  </p>

  <p>
    <strong>Price:</strong>
    $<%= product.product_prices.last&.price || "N/A" %>
  </p>

  <p>
    <strong>Effective date:</strong>
    <%= product_price.effective_date %>
  </p>

</div>
