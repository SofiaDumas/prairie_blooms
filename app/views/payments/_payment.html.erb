<div id="<%= dom_id payment %>">
  <p>
    <strong>Order:</strong>
    <%= payment.order_id %>
  </p>

  <p>
    <strong>Payment method:</strong>
    <%= payment.payment_method %>
  </p>

  <p>
    <strong>Total amount:</strong>
    <%= payment.total_amount_id %>
  </p>

  <p>
    <strong>Payment status:</strong>
    <%= payment.payment_status %>
  </p>

</div>
